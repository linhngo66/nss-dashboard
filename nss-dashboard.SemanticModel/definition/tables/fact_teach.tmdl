	column benchmark_pct = fact_teach[benchmark] / 100
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6c6d2ff2-2943-478d-b5e9-8bf0da017809
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition fact_teach = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "fact_teach.parquet")),
				    NoHC = Table.SelectRows(Source, each not Text.StartsWith([question_no], "HC")),
				    Typed = Table.TransformColumnTypes(NoHC, {
				        {"ukprn", type text}, {"provider_name", type text}, {"mode_of_study", type text}, {"level_of_study", type text},
				        {"subject_level", type text}, {"cah1_code", type text}, {"cah1_name", type text}, {"cah2_code", type text}, {"cah2_name", type text},
				        {"cah_code", type text}, {"cah_name", type text}, {"theme_no", Int64.Type}, {"question_no", type text},
				        {"number_responses", type number}, {"number_population", type number},
				        {"option1", type number}, {"option2", type number}, {"option3", type number}, {"option4", type number}, {"option5", type number}, {"not_applicable", type number},
				        {"positivity_measure", type number}, {"standard_deviation", type number}, {"benchmark", type number}, {"difference", type number}, {"contr_benchmark", type number},
				        {"materially_below_bench", type number}, {"inline_with_bench", type number}, {"materially_above_bench", type number},
				        {"difference_lowerci95", type number}, {"difference_upperci95", type number}, {"indicator_lowerci95", type number}, {"indicator_upperci95", type number},
				        {"pub_response_headcount", type number}, {"pub_resprate", type number}, {"benchmark_category", type text}})
				in
				    Typed

